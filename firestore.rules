rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidPayloadSize() {
      return request.resource.data.keys().size() <= 120;
    }

    function hasValidAdminId() {
      return request.resource.data.adminId is string &&
             request.resource.data.adminId.size() >= 1 &&
             request.resource.data.adminId.size() <= 128;
    }

    function hasValidNonNegNumber(field) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is number && request.resource.data[field] >= 0 && request.resource.data[field] <= 1000000000000);
    }

    function isPlatformAdmin() {
      return isAuthenticated() &&
             request.auth.token.email == 'waadpc90@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    // Global app settings: readable by all apps, writable ONLY by verified platform admin (or Admin REST/Console)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isPlatformAdmin() && isValidPayloadSize();
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidPayloadSize();
      allow delete: if false;
    }

    match /workers/{workerId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidPayloadSize() && hasValidNonNegNumber('wage');
      allow delete: if isAuthenticated();
    }

    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidPayloadSize() && hasValidAdminId() && hasValidNonNegNumber('amount');
      allow delete: if isAuthenticated();
    }

    match /attendance/{attId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidPayloadSize();
      allow delete: if isAuthenticated();
    }

    match /payments/{payId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidPayloadSize() && hasValidAdminId() && hasValidNonNegNumber('amount');
      allow delete: if isAuthenticated();
    }

    match /expenses/{expId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidPayloadSize() && hasValidAdminId() && hasValidNonNegNumber('cost');
      allow delete: if isAuthenticated();
    }

    match /advances/{advId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidPayloadSize() && hasValidAdminId() && hasValidNonNegNumber('amount');
      allow delete: if isAuthenticated();
    }

    match /monthly_snapshots/{snapId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidPayloadSize() && hasValidAdminId();
      allow delete: if isAuthenticated();
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidPayloadSize();
      allow delete: if isAuthenticated();
    }

    match /market_requests/{reqId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidPayloadSize();
      allow delete: if isAuthenticated();
    }

    match /job_ads/{adId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidPayloadSize();
      allow delete: if isAuthenticated();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isValidPayloadSize();
      allow delete: if isAuthenticated();
    }

    match /store_products/{prodId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isValidPayloadSize() && hasValidNonNegNumber('price');
      allow delete: if isAuthenticated();
    }

    match /store_orders/{orderId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidPayloadSize();
      allow delete: if isAuthenticated();
    }

    match /media_blobs/{blobId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isValidPayloadSize();
      allow delete: if isAuthenticated();
    }

    // Append-only Financial Audit Trail (cannot be altered or deleted by clients)
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidPayloadSize() && hasValidAdminId();
      allow update, delete: if false;
    }

    // Default-deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
